# Netlify header config. Drop this file in the project's public/ folder
# (Vite copies everything in public/ into dist/ as-is, and Netlify reads
# _headers from the deploy root) — or in the repo root if you deploy from
# root without a build step. For this Vite project, put it at:
#   public/_headers
#
# Unlike the <meta http-equiv="Content-Security-Policy"> tag in index.html,
# real HTTP headers can carry frame-ancestors (clickjacking protection) and
# headers that meta tags cannot express at all (HSTS, Permissions-Policy,
# X-Frame-Options). Keep the meta tag in index.html too — it's a harmless
# fallback if this file is ever missing from a deploy.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

# Content-hashed JS/CSS — safe to cache forever, filename changes on any change
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the service worker itself — it's the thing that decides
# whether the browser sees a new version at all
/sw.js
  Cache-Control: no-cache

/workbox-*.js
  Cache-Control: no-cache

# Manifest and unhashed icons: short cache so a changed icon/name shows up
# promptly instead of being stuck behind a long-lived cache
/manifest.webmanifest
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=3600

/favicon.ico
  Cache-Control: public, max-age=3600

# HTML must always be revalidated — this is what points at the (possibly
# new) hashed asset filenames, so it can never be cached long-lived
/index.html
  Cache-Control: no-cache
